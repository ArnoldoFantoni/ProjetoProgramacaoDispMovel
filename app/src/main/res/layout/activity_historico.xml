<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="20dp">

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Histórico de Registros (SQLite)"
    android:textSize="20sp"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginBottom="16dp"/>

<!-- ScrollView permite rolar a tela caso tenha vários registros salvos -->
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <TextView
        android:id="@+id/txtHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carregando registros..."
        android:textSize="16sp"/>

</ScrollView>
<!-- Botão para voltar à tela principal -->
<Button
    android:id="@+id/btnVoltar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Voltar para a Tela Principal"
    android:textSize="16sp"/>

</LinearLayout>